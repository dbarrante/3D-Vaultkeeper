# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
bun-debug.log*

# Dependency directories
node_modules

# Build output
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.code-workspace

# Virtual Environments
.venv
venv/

# Python
__pycache__
*.pyc

# Lock files
package-lock.json
yarn.lock
pnpm-lock.yaml
bun.lock

# Backend
/backend/__pycache__/
/backend/data/
/backend/*.db
/backend/*.db-journal
/backend/uploads/
# app/uploads is FILE_STORAGE's local-dev fallback path (see app/db.py) when the
# env var isn't set — NOT the app/ Python package itself, which is real source.
/backend/app/uploads/

# Control app runtime state (pidfiles, logs) — not source
/control-app/.run/
/control-app/launch.log

# Real local dev database + the user's actual library files (currently
# ~2000+ real files, 24GB+ once watched-folder references are added) —
# never belongs in git regardless of where DB_PATH/FILE_STORAGE point.
/dev-data/